# Environment Configuration
ENV=development

# Model Configuration
MODEL_VERSION=v1.0.0
MODEL_PATH=models/credit_risk_model.pkl

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Risk Thresholds
HIGH_RISK_THRESHOLD=0.15
MEDIUM_RISK_THRESHOLD=0.08
LOW_RISK_THRESHOLD=0.04

# Monitoring
PSI_THRESHOLD=0.1
DRIFT_CHECK_INTERVAL=1000

# Kaggle API (for data download)
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_key
